# Local development only. Generate a unique secret for every deployed environment.
DJANGO_SECRET_KEY=insecure-development-only-change-before-deployment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# Local PostgreSQL settings
DB_NAME=student_management_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_HOST_PORT=5432

# Frontend integration
NEXT_PUBLIC_APP_NAME=Student Management SaaS
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TIME_ZONE=UTC
LOG_LEVEL=INFO
